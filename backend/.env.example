# Copy this file to `.env` and fill in your values. The backend reads it at startup.

# --- Optional: JWT signing secret (generate one with: python -c "import secrets; print(secrets.token_hex(32))") ---
#CIVICLENS_JWT_SECRET=replace-me-with-a-long-random-string

# --- Optional: agent pipeline LLM (OpenRouter free models are the default) ---
# Set your OpenRouter API key to enable the LLM-driven agents (duplication,
# routing, summary). Without a key the agents run on deterministic rules.
#CIVICLENS_LLM_PROVIDER=openrouter      # "openrouter", "ollama", or "none"
#CIVICLENS_OPENROUTER_API_KEY=sk-or-v1-...
#CIVICLENS_OPENROUTER_MODEL=openai/gpt-oss-20b:free
#CIVICLENS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Optional: local Ollama (used when openrouter is unset/unavailable) ---
#CIVICLENS_OLLAMA_MODEL=qwen2.5:3b
#CIVICLENS_OLLAMA_BASE_URL=http://localhost:11434
#CIVICLENS_CONFIDENCE_THRESHOLD=0.60
